<Many Model="Model"
      T="BlogLicenseModel"
      EntityName="Blog License"
      SaveRequested="id => Model.Save(id)"
      CancelRequested="id => Model.Cancel(id)"
      DeleteRequested="id => Model.Delete(id)">
    <ReadView>
        <div></div>
    </ReadView>
    <EditView>
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Blog"
                   Size="Field.Sizes.Medium">
                <Dropdown ReadOnly="@false"
                          LookupValues="Model.BlogNames"
                          @bind-Value="context.BlogLicense.BlogId" />
            </Field>
        </Wrapped>
    </EditView>
</Many>