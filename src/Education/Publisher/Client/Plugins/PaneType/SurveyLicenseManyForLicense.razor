<Many Model="Model"
      T="SurveyLicenseModel"
      EntityName="Survey License"
      SaveRequested="id => Model.Save(id)"
      CancelRequested="id => Model.Cancel(id)"
      DeleteRequested="id => Model.Delete(id)">
    <ReadView>
        <div></div>
    </ReadView>
    <EditView>
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Survey"
                   Size="Field.Sizes.Medium">
                <Dropdown ReadOnly="@false"
                          LookupValues="Model.SurveyNames"
                          @bind-Value="context.SurveyLicense.SurveyId" />
            </Field>
        </Wrapped>
    </EditView>
</Many>