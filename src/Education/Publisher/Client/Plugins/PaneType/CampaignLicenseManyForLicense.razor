<Many Model="Model"
      T="CampaignLicenseModel"
      EntityName="Campaign License"
      SaveRequested="id => Model.Save(id)"
      CancelRequested="id => Model.Cancel(id)"
      DeleteRequested="id => Model.Delete(id)">
    <ReadView>
        <div></div>
    </ReadView>
    <EditView>
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Campaign"
                   Size="Field.Sizes.Medium">
                <Dropdown ReadOnly="@false"
                          LookupValues="Model.CampaignNames"
                          @bind-Value="context.CampaignLicense.CampaignId" />
            </Field>
        </Wrapped>
    </EditView>
</Many>