@using Crudspa.Content.Display.Client.Contracts.Events

@if (RenderModel is not null && (RenderShowGuideFields || RenderShowNotebookButton))
{
    <div class="c-guide c-nowrap">
        @if (RenderShowGuideFields)
        {
            <div>
                <Image ImageFile="RenderModel.Image"
                       Width="90" />
            </div>

            <div class="star quote c-nowrap @(RenderModel.Text.HasNothing() && RenderModel.Audio?.Id is null ? "transparent" : String.Empty)">
                <div class="star text">
                    @(RenderModel.Text)
                </div>
                @if (RenderModel.Audio?.Id is not null)
                {
                    <div>
                        <AudioPlayer AudioFile="RenderModel.Audio"
                                     PlayText="@null"
                                     StopText="@null"
                                     PlayIcon="c-icon-volume-high"
                                     StopIcon="c-icon-volume-high"
                                     AutoPlay="@AutoPlay" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="star">
                &nbsp;
            </div>
        }

        @if (RenderShowNotebookButton)
        {
            <div>
                <button @onclick="() => EventBus.Publish(new OpenNotebook())">
                    <div class="c-button">
                        <div class="icon"
                             style="padding: .375em 0 .125em 0; width: 2em;">
                            <img src="/api/content/display/images/notebook"
                                 alt="Notebook" />
                        </div>
                    </div>
                </button>
            </div>
        }
    </div>
}