@if (Config is not null)
{
    <Wrapped>
        <Field Label="URLs"
               Size="Field.Sizes.Full">
            <MultilineTextBox ReadOnly="ReadOnly"
                              Height="MultilineTextBox.Heights.Short"
                              @bind-Value="Config.Urls" />
        </Field>
        <Field Label="Expected Max Latency (ms)"
               Size="Field.Sizes.Small">
            <NumericTextBox ReadOnly="ReadOnly"
                            @bind-Value="Config.ExpectedMaxLatencyMs" />
        </Field>
    </Wrapped>
}