@{
    var lookupValues = (LookupValues ?? Enumerable.Empty<INamed>()).Take(MaxOptionCount + 1).ToList();
    var hasTooManyOptions = lookupValues.Count > MaxOptionCount;
}
<select @onchange="HandleValueChanged"
        disabled="@ReadOnly">
    @if (AllowNull)
    {
        <option value="">@NullText</option>
    }
    @if (hasTooManyOptions)
    {
        <option disabled="disabled">
            Too many options to display.
        </option>
    }
    else if (lookupValues.HasItems())
    {
        @foreach (var named in lookupValues)
        {
            <option value="@named.Id"
                    selected="@(named.Id == Value)">
                @named.Name
            </option>
        }
    }
</select>