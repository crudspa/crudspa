@if (Pane is not null)
{
    <ErrorRecover>
        <PaneDisplayPlugin TypeName="@Pane.TypeDisplayView"
                           Path="@Path"
                           PaneId="@PaneId"
                           Id="@DisplayId"
                           IsNew="@Pane.IsNew"
                           ConfigJson="@Pane.ConfigJson" />
    </ErrorRecover>
}