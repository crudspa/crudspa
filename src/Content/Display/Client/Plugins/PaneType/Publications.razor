<Waiter Model="Model">
    <div class="c-publications">
        <div class="c-publications-tools">
            <label>
                <span>Search publications</span>
                <input type="search" placeholder="Title, author, or research topic" @bind="Model.Search" @bind:event="oninput" />
            </label>
            @if (!Model.Config.GroupId.HasValue)
            {
                <label>
                    <span>Research area</span>
                    <select @bind="Model.GroupFilter">
                        <option value="">All research areas</option>
                        @foreach (var group in Model.Available.Where(x => x.GroupId.HasValue).GroupBy(x => x.GroupId).OrderBy(x => x.First().GroupOrdinal))
                        {
                            <option value="@(group.Key?.ToString("D"))">@group.First().GroupName</option>
                        }
                    </select>
                </label>
            }
            <label>
                <span>Order</span>
                <select @bind="Model.Config.SortOrder">
                    <option value="@Crudspa.Content.Display.Shared.Contracts.Config.PaneType.PublicationsConfig.SortOrders.Manual">Selected order</option>
                    <option value="@Crudspa.Content.Display.Shared.Contracts.Config.PaneType.PublicationsConfig.SortOrders.Newest">Newest first</option>
                </select>
            </label>
        </div>
        <p class="c-publications-count" role="status">@Model.Results.Count() @(Model.Results.Count() == 1 ? "publication" : "publications")</p>
        @if (!Model.Results.Any())
        {
            <p class="c-publications-empty">@(Model.Available.Any() ? "No publications match your search." : "Publications will appear here as they become available.")</p>
        }
        @foreach (var section in Model.Sections)
        {
            @if (Model.Config.Grouped) { <h2 class="c-publications-group">@(section.First().GroupName ?? "More research")</h2> }
            <div class="c-publications-grid">
                @foreach (var publication in section)
                {
                    <article class="c-publication" @key="publication.Id">
                        @if (publication.ImageFile.Id.HasValue)
                        {
                            <div class="c-publication-cover">
                                <img src="@publication.ImageFile.FetchUrl(360)" loading="lazy" decoding="async"
                                     width="@publication.ImageFile.Width" height="@publication.ImageFile.Height"
                                     alt="@(publication.ImageAlt ?? publication.ImageFile.Caption ?? String.Empty)" />
                            </div>
                        }
                        <div class="c-publication-body">
                            @if (publication.Venue.HasSomething() || publication.Year.HasValue)
                            {
                                <p class="c-publication-venue">@publication.Venue @if (publication.Year.HasValue) { <span>@publication.Year</span> }</p>
                            }
                            <h3>@publication.Title</h3>
                            @if (publication.Citation.HasSomething()) { <p class="c-publication-citation">@publication.Citation</p> }
                            <div class="c-publication-resources">
                                @foreach (var resource in publication.PublicationResources.OrderBy(x => x.Ordinal).ThenBy(x => x.Id))
                                {
                                    <a href="@PublicationsModel.ResourceUrl(resource)" target="_blank" rel="noopener noreferrer">
                                        @PublicationsModel.ResourceLabel(resource)
                                        @if (resource.PdfFile.Id.HasValue) { <span class="c-publication-format">PDF</span> }
                                        @if (resource.ImageFile.Id.HasValue) { <span class="c-publication-format">Image</span> }
                                    </a>
                                }
                            </div>
                            @if (new[] { publication.Sample, publication.Timeline, publication.Outcome, publication.Intervention }.Any(x => x.HasSomething()))
                            {
                                <details class="c-publication-details">
                                    <summary>Study details</summary>
                                    <dl>
                                        @if (publication.Sample.HasSomething()) { <dt>Sample</dt><dd>@publication.Sample</dd> }
                                        @if (publication.Timeline.HasSomething()) { <dt>Timeline</dt><dd>@publication.Timeline</dd> }
                                        @if (publication.Outcome.HasSomething()) { <dt>Outcome of interest</dt><dd>@publication.Outcome</dd> }
                                        @if (publication.Intervention.HasSomething()) { <dt>Intervention</dt><dd>@publication.Intervention</dd> }
                                    </dl>
                                </details>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</Waiter>