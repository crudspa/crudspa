<List Model="Model"
      T="MembershipModel"
      EntityName="Membership"
      UrlPrefix="@($"{Path}/email-membership")"
      ShowDelete="false">
    <ReadView>
        <Field Size="Field.Sizes.Unspecified">
            <LabeledHtml Label="Description"
                         HtmlValue="@context.Membership.Description" />
            <Labeled Width="6em"
                     Label="Supports Opt Out"
                     BooleanValue="@context.Membership.SupportsOptOut" />
        </Field>
    </ReadView>
    <PaneLinks>
        <PaneLink Href="@($"{Path}/email-membership-{context.Membership.Id:D}?pane=messages")"
                  Text="Messages"
                  Count="context.Membership.EmailCount" />
        <PaneLink Href="@($"{Path}/email-membership-{context.Membership.Id:D}?pane=templates")"
                  Text="Templates"
                  Count="context.Membership.EmailTemplateCount" />
    </PaneLinks>
</List>