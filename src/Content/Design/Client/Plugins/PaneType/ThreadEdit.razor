<Toolbar>
    <Left>
        @if (Model.ReadOnly)
        {
            <ButtonEdit Clicked="Model.Edit" />
        }
        else
        {
            <ButtonGroup>
                <ButtonSave Clicked="Model.Save" />
                <ButtonCancel Clicked="HandleCancelClicked" />
            </ButtonGroup>
        }
    </Left>
</Toolbar>
<Waiter Model="Model">
    @if (Model.Entity is not null)
    {
        <div class="c-forum-shell">
            @if (Model.ReadOnly)
            {
                <ForumMessage Comment="Model.Entity.Comment"
                              Title="@Model.Entity.Title"
                              Pinned="Model.Entity.Pinned == true"
                              Opening="true">
                    <Body>
                        <UserHtml Html="@Model.Entity.Comment.Body" />
                        @foreach (var media in Model.Entity.Comment.CommentMedias.OrderBy(x => x.Ordinal))
                        {
                            <ForumMediaPreview Media="media" />
                        }
                    </Body>
                </ForumMessage>
            }
            else
            {
                <div class="c-forum-composer">
                    <Field Label="Title" Size="Field.Sizes.Wide">
                        <TextBox ReadOnly="false" MaxLength="150" @bind-Value="Model.Entity.Title" />
                    </Field>
                    <Field Label="Message" Size="Field.Sizes.Full" Container="Field.Containers.Div">
                        <HtmlEditor ReadOnly="false" @bind-Value="Model.Entity.Comment.Body" />
                    </Field>
                    <Field Label="Options" Container="Field.Containers.Div">
                        <Checkbox Label="Pinned" ReadOnly="false" @bind-Value="Model.Entity.Pinned" />
                    </Field>
                </div>
            }

            @if (!IsNew)
            {
                <CommentTreeForThread Path="Path" Id="Id" IsNew="false" />
            }
        </div>
    }
</Waiter>