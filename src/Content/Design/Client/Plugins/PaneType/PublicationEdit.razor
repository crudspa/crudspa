<Toolbar>
    <Left>
        <ButtonGroup>
            @if (Model.ReadOnly)
            {
                <ButtonEdit Clicked="() => Model.Edit()" />
            }
            else
            {
                <ButtonSave Clicked="() => Model.Save()" />
                <ButtonCancel Clicked="HandleCancelClicked" />
            }
        </ButtonGroup>
    </Left>
</Toolbar>
<p class="c-publication-editor-note">Complete publications appear on the public site. Saving a Complete publication updates its public content.</p>
<Waiter Model="Model">
    @if (Model.Entity is not null)
    {
        <Padding Size="Padding.Sizes.Small"
                 Direction="Padding.Directions.Vertical">
            <Wrapped Alignment="Wrapped.Alignments.Top">
                <Field Label="Group"
                       Size="Field.Sizes.Wide">
                    <Dropdown ReadOnly="Model.ReadOnly"
                              AllowNull="true"
                              NullText="[None]"
                              LookupValues="Model.PublicationGroupNames"
                              @bind-Value="Model.Entity.GroupId" />
                </Field>
                <Field Label="Status"
                       Size="Field.Sizes.Wide">
                    <Dropdown ReadOnly="Model.ReadOnly"
                              LookupValues="Model.ContentStatusNames"
                              @bind-Value="Model.Entity.StatusId" />
                </Field>
                <Field Label="Title"
                       Size="Field.Sizes.Wide">
                    <TextBox ReadOnly="Model.ReadOnly"
                             MaxLength="300"
                             @bind-Value="Model.Entity.Title" />
                </Field>
                <Field Label="Citation"
                       Size="Field.Sizes.Full">
                    <MultilineTextBox ReadOnly="Model.ReadOnly"
                                      Height="MultilineTextBox.Heights.Tall"
                                      @bind-Value="Model.Entity.Citation" />
                </Field>
                <Field Label="Venue"
                       Size="Field.Sizes.Wide">
                    <TextBox ReadOnly="Model.ReadOnly"
                             MaxLength="250"
                             @bind-Value="Model.Entity.Venue" />
                </Field>
                <Field Label="Sample"
                       Size="Field.Sizes.Wide">
                    <TextBox ReadOnly="Model.ReadOnly"
                             MaxLength="500"
                             @bind-Value="Model.Entity.Sample" />
                </Field>
                <Field Label="Timeline"
                       Size="Field.Sizes.Wide">
                    <TextBox ReadOnly="Model.ReadOnly"
                             MaxLength="100"
                             @bind-Value="Model.Entity.Timeline" />
                </Field>
                <Field Label="Outcome"
                       Size="Field.Sizes.Wide">
                    <TextBox ReadOnly="Model.ReadOnly"
                             MaxLength="1000"
                             @bind-Value="Model.Entity.Outcome" />
                </Field>
                <Field Label="Intervention"
                       Size="Field.Sizes.Wide">
                    <TextBox ReadOnly="Model.ReadOnly"
                             MaxLength="1000"
                             @bind-Value="Model.Entity.Intervention" />
                </Field>
                <Field Label="Image"
                       Size="Field.Sizes.Wide"
                       Container="Field.Containers.Div">
                    <ImageUploader ReadOnly="Model.ReadOnly"
                                   Required="false"
                                   ImageFile="Model.Entity.ImageFile" />
                </Field>
                <Field Label="Image Alt"
                       Size="Field.Sizes.Wide">
                    <TextBox ReadOnly="Model.ReadOnly"
                             MaxLength="300"
                             @bind-Value="Model.Entity.ImageAlt" />
                </Field>
                <Field Label="Year"
                       Size="Field.Sizes.Wide">
                    <NumericTextBox ReadOnly="Model.ReadOnly"
                                    @bind-Value="Model.Entity.Year" />
                </Field>
            </Wrapped>
        </Padding>
        <Padding Size="Padding.Sizes.Small"
                 Direction="Padding.Directions.Vertical">
            <BatchSection Title="Publication Resources">
                <HeadingPanel>
                    <ButtonAdd EntityName="Publication Resource"
                               Disabled="Model.ReadOnly"
                               Transparent="true"
                               Clicked="() => Model.AddPublicationResource()">
                    </ButtonAdd>
                </HeadingPanel>
                <ChildContent>
                    <Batch Model="Model.PublicationResourcesModel"
                           ReadOnly="Model.ReadOnly">
                        <EditView>
                            <Wrapped Alignment="Wrapped.Alignments.Top"
                                     @key="context">
                                <Field Label="Type"
                                       Size="Field.Sizes.Larger">
                                    <Dropdown ReadOnly="Model.ReadOnly"
                                              LookupValues="Model.PublicationResourceTypeNames"
                                              @bind-Value="context.TypeId" />
                                </Field>
                                <Field Label="Label"
                                       Size="Field.Sizes.Larger">
                                    <TextBox ReadOnly="Model.ReadOnly"
                                             MaxLength="150"
                                             @bind-Value="context.Label" />
                                </Field>
                                <Field Label="Destination" Size="Field.Sizes.Full" Container="Field.Containers.Div">
                                    <EnumRadio TEnum="PublicationResource.Destinations" ReadOnly="Model.ReadOnly" @bind-SelectedValue="context.SelectedDestination" />
                                </Field>
                                @switch (context.SelectedDestination)
                                {
                                    case PublicationResource.Destinations.Link:
                                        <Field Label="Link" Size="Field.Sizes.Full"><TextBox ReadOnly="Model.ReadOnly" MaxLength="2000" @bind-Value="context.Url" /></Field>
                                        break;
                                    case PublicationResource.Destinations.Pdf:
                                        <Field Label="PDF" Size="Field.Sizes.Full"><PdfUploader ReadOnly="Model.ReadOnly" Required="true" PdfFile="context.PdfFile" /></Field>
                                        break;
                                    case PublicationResource.Destinations.Image:
                                        <Field Label="Image" Size="Field.Sizes.Full"><ImageUploader ReadOnly="Model.ReadOnly" Required="true" ImageFile="context.ImageFile" /></Field>
                                        break;
                                }
                            </Wrapped>
                        </EditView>
                    </Batch>
                </ChildContent>
            </BatchSection>
        </Padding>
    }
</Waiter>