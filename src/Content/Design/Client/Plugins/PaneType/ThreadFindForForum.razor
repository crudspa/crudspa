<Waiter Model="Model">
    <Filters>
        <Fields>
            <Field Label="Search"
                   Size="Field.Sizes.Medium">
                <SearchTextBox @bind-Value="Model.Search.Text" />
            </Field>
            <Field Label="Posted"
                   Size="Field.Sizes.Medium">
                <DateFilter Range="Model.Search.PostedRange" />
            </Field>
            <Sorter Sorts="Model.Sorts"
                    @bind-Selected="Model.Search.Sort.Field"
                    @bind-Ascending="Model.Search.Sort.Ascending" />
        </Fields>
        <Buttons>
            <ContextMenu ButtonStyle="ContextMenu.ButtonStyles.Create">
                <MenuItem Type="MenuItem.Types.Reset"
                          Clicked="() => Model.Reset()" />
                <MenuItem Type="MenuItem.Types.Refresh"
                          Clicked="() => Model.Refresh()" />
            </ContextMenu>
        </Buttons>
    </Filters>
</Waiter>
<div class="c-forum-shell">
    @if (Model.Cards.IsEmpty())
    {
        <NoRecords EntityName="threads" />
    }
    else
    {
        @foreach (var card in Model.Cards)
        {
            <Modal Model="card.ConfirmationModel">
                <Content>
                    <Padding Direction="Padding.Directions.Top" Size="Padding.Sizes.Small">
                        Are you sure you want to delete '@card.Entity.Title'?
                    </Padding>
                </Content>
                <Buttons>
                    <ButtonDelete Clicked="() => Model.Delete(card.Entity.Id)" />
                    <ButtonCancel Clicked="() => card.ConfirmationModel.Hide()" />
                </Buttons>
            </Modal>
            <ForumMessage Comment="card.Entity.Comment"
                          Title="@card.Entity.Title"
                          Pinned="card.Entity.Pinned == true">
                <Body>
                    <UserHtml Html="@card.Entity.Comment.Body" />
                </Body>
                <Footer>
                    <div class="c-forum-topic-footer">
                        <a href="@($"{Path}/thread-{card.Entity.Id:D}")">
                            @card.Entity.CommentCount @(card.Entity.CommentCount == 1 ? "reply" : "replies")
                        </a>
                    </div>
                    <div class="c-forum-actions">
                        <ButtonView Href="@($"{Path}/thread-{card.Entity.Id:D}")" Text="Open discussion" />
                        <ContextMenu ButtonStyle="ContextMenu.ButtonStyles.View">
                            <MenuItem Type="MenuItem.Types.Delete"
                                      Clicked="() => Model.ShowConfirmation(card.Entity.Id)" />
                        </ContextMenu>
                    </div>
                </Footer>
            </ForumMessage>
        }

        <Pager Paged="Model.Search.Paged"
               PageNumberChanged="Model.HandlePageNumberChanged" />
    }
</div>