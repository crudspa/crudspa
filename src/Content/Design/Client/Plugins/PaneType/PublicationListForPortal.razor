<ListOrderables Model="Model"
                T="PublicationModel"
                EntityName="Publication"
                UrlPrefix="@($"{Path}/publication")"
                DeleteRequested="id => Model.Delete(id)"
                MoveUpRequested="id => Model.MoveUp(id)"
                MoveDownRequested="id => Model.MoveDown(id)">
    <ReadView>
        @if (context.Publication.ImageFile.Id.HasSomething())
        {
            <Field Size="Field.Sizes.Unspecified">
                <Image ImageFile="context.Publication.ImageFile" Width="160" />
            </Field>
        }
        <Field Size="Field.Sizes.Full">
            <Labeled Width="8em"
                     Label="Venue"
                     StringValue="@context.Publication.Venue" />
            <Labeled CssClass="status" Width="8em" Label="Status">
                <StatusDisplay Id="@context.Publication.StatusId"
                               Name="@context.Publication.StatusName"
                               ColorClassFrom="ContentStatusColors.For" />
            </Labeled>
            <Labeled Width="8em"
                     Label="Group"
                     StringValue="@context.Publication.GroupName" />
        </Field>
        <Field Size="Field.Sizes.Unspecified">
            <LabeledBatch Label="Publication Resources"
                          Width="8em"
                          Items="context.Publication.PublicationResources.OrderBy(x => x.Ordinal)"
                          Context="item">
                <ReadView>
                    @(item.Name)
                </ReadView>
            </LabeledBatch>
        </Field>
    </ReadView>
</ListOrderables>