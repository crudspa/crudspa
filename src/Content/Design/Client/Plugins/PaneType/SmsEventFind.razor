<Waiter Model="Model">
    <Filters>
        <Fields>
            <Field Label="Search"
                   Size="Field.Sizes.Medium">
                <SearchTextBox @bind-Value="Model.Search.Text" />
            </Field>
            <Field Label="Received"
                   Size="Field.Sizes.Medium">
                <DateFilter Range="Model.Search.ReceivedRange" />
            </Field>
            <Sorter Sorts="Model.Sorts"
                    @bind-Selected="Model.Search.Sort.Field"
                    @bind-Ascending="Model.Search.Sort.Ascending" />
        </Fields>
        <Buttons>
            <ContextMenu ButtonStyle="ContextMenu.ButtonStyles.Create">
                <MenuItem Type="MenuItem.Types.Reset"
                          Clicked="() => Model.Reset()" />
                <MenuItem Type="MenuItem.Types.Refresh"
                          Clicked="() => Model.Refresh()" />
            </ContextMenu>
        </Buttons>
    </Filters>
</Waiter>
@if (Model.Cards.IsEmpty())
{
    <NoRecords EntityName="sms events" />
}
else
{
    @foreach (var card in Model.Cards)
    {
        <Card Model="card"
              Title="@card.Entity.ProviderMessageId"
              SupportsDelete="true"
              DeleteRequested="() => Model.Delete(card.Entity.Id)">
            <Values>
                <Field Size="Field.Sizes.Unspecified">
                    <Labeled Width=""
                             Label="Provider"
                             StringValue="@card.Entity.Provider.GetLabel()" />
                    <Labeled Width=""
                             Label="Type"
                             StringValue="@card.Entity.Type.GetLabel()" />
                    <Labeled Width=""
                             Label="Provider Message"
                             StringValue="@card.Entity.ProviderMessageId" />
                    <Labeled Width=""
                             Label="Provider Status"
                             StringValue="@card.Entity.ProviderStatus" />
                    <Labeled Width=""
                             Label="Signature Valid"
                             BooleanValue="@card.Entity.SignatureValid" />
                    <Labeled Width=""
                             Label="Received"
                             DateTimeOffsetValue="@card.Entity.Received" />
                    <Labeled Width=""
                             Label="Processed"
                             DateTimeOffsetValue="@card.Entity.Processed" />
                    <Labeled Width=""
                             Label="Status"
                             StringValue="@card.Entity.Status.GetLabel()" />
                    <Labeled Width=""
                             Label="Error Message"
                             StringValue="@card.Entity.ErrorMessage" />
                </Field>
            </Values>
        </Card>
    }

    <Pager Paged="Model.Search.Paged"
           PageNumberChanged="Model.HandlePageNumberChanged" />
}