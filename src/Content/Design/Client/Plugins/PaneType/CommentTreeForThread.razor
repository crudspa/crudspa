<div class="c-forum-replies">
    <div class="heading">
        <h3>Replies</h3>
        <ButtonAdd Clicked="Model.CreateRoot"
                   EntityName="reply" />
    </div>
    <Waiter Model="Model">
        @if (Model.Roots.IsEmpty())
        {
            <p>No replies yet.</p>
        }
        else
        {
            @foreach (var node in Model.Roots)
            {
                <ForumCommentEditor Node="node" Model="Model" ThreadId="Id" @key="node.Entity" />
            }
        }
    </Waiter>
</div>