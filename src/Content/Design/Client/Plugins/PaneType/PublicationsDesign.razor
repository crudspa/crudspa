@using Crudspa.Content.Display.Shared.Contracts.Config.PaneType
<Wrapped>
    <Field Label="Research area" Size="Field.Sizes.Wide">
        <Dropdown LookupValues="Groups.Select(x => new Named { Id = x.Id, Name = x.Name }).ToList()"
                  ReadOnly="ReadOnly" AllowNull="true" NullText="All research areas" @bind-Value="Config.GroupId" />
    </Field>
    <Field Label="Default order" Size="Field.Sizes.Wide" Container="Field.Containers.Div">
        <EnumRadio TEnum="PublicationsConfig.SortOrders" ReadOnly="ReadOnly" @bind-SelectedValue="Config.SortOrder" />
    </Field>
    <Field Label="Options" Size="Field.Sizes.Wide" Container="Field.Containers.Div">
        <Checkbox ReadOnly="ReadOnly" Label="Group publications by research area" Value="Config.Grouped" ValueChanged="value => Config.Grouped = value == true" />
    </Field>
</Wrapped>
<Padding Size="Padding.Sizes.Small" Direction="Padding.Directions.Vertical">
    <ButtonCore Text="Preview catalog" IconClass="c-icon-eye" ButtonStyle="ButtonCore.ButtonStyles.View" Clicked="LoadPreview" />
</Padding>
@if (Preview is not null)
{
    <Padding Size="Padding.Sizes.Small" Direction="Padding.Directions.Vertical">
        <div class="parenthetical">Preview includes Draft, Complete, and Retired entries. Only Complete entries appear publicly.</div>
    </Padding>
    <ThemePreview PortalId="@(Path!.Id("portal"))" Surface="ThemePreview.Surfaces.Page">
        <Crudspa.Content.Display.Client.Plugins.PaneType.Publications ConfigJson="@GetConfigJson()" PreviewPublications="Preview" />
    </ThemePreview>
}
@if (PreviewError is not null) { <p role="alert">@PreviewError</p> }