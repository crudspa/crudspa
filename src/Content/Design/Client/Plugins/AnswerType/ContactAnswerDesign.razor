<Wrapped Alignment="Wrapped.Alignments.Top">
    <Field Label="Kind"
           Size="Field.Sizes.Medium"
           Container="Field.Containers.Div">
        <EnumRadio TEnum="ContactAnswer.Kinds"
                   ReadOnly="ReadOnly"
                   @bind-SelectedValue="Kind" />
    </Field>
    <Field Label="Label"
           Size="Field.Sizes.Medium">
        <TextBox ReadOnly="ReadOnly"
                 MaxLength="150"
                 @bind-Value="Answer.Label" />
    </Field>
</Wrapped>