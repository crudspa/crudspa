@{
    const String border = "Border";
    const String font = "Font";
    const String frame = "Frame";
    const String margin = "Margin";
    const String padding = "Padding";
    const String shadow = "Shadow";
    const String text = "Text";
}
<div class="c-tabbed-panes vertical">
<ul class="tabs secondary">
    <li class="@(Model.ActiveTab.IsBasically(border) ? "selected" : String.Empty)"
        @onclick="() => Model.SetActiveTab(border)">
        @border
    </li>
    <li class="@(Model.ActiveTab.IsBasically(font) ? "selected" : String.Empty)"
        @onclick="() => Model.SetActiveTab(font)">
        @font
    </li>
    <li class="@(Model.ActiveTab.IsBasically(frame) ? "selected" : String.Empty)"
        @onclick="() => Model.SetActiveTab(frame)">
        @frame
    </li>
    <li class="@(Model.ActiveTab.IsBasically(margin) ? "selected" : String.Empty)"
        @onclick="() => Model.SetActiveTab(margin)">
        @margin
    </li>
    <li class="@(Model.ActiveTab.IsBasically(padding) ? "selected" : String.Empty)"
        @onclick="() => Model.SetActiveTab(padding)">
        @padding
    </li>
    <li class="@(Model.ActiveTab.IsBasically(shadow) ? "selected" : String.Empty)"
        @onclick="() => Model.SetActiveTab(shadow)">
        @shadow
    </li>
    <li class="@(Model.ActiveTab.IsBasically(text) ? "selected" : String.Empty)"
        @onclick="() => Model.SetActiveTab(text)">
        @text
    </li>
</ul>
<div class="panes match-tab-color">
<div class="@(Model.ActiveTab.IsBasically(border) ? String.Empty : "c-hide")">
    <Padding Size="Padding.Sizes.Small"
             Direction="Padding.Directions.Vertical">
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Color"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.BorderColorState">
                    <div>
                        <ColorPicker @bind-Value="Model.Box.BorderColor" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Radius"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.BorderRadiusState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="0.5em"
                                 @bind-Value="Model.Box.BorderRadius" />
                    </div>
                </DefaultOverride>
            </Field>
        </Wrapped>
        <BatchSection Title="Thickness">
            <Padding Direction="Padding.Directions.Top"
                     Size="Padding.Sizes.Small">
                <Wrapped Alignment="Wrapped.Alignments.Top">
                    <Field Label="All"
                           Size="Field.Sizes.Medium"
                           Container="Field.Containers.Div">
                        <DefaultOverride @bind-State="Model.BorderThicknessState">
                            <div class="c-min">
                                <TextBox MaxLength="10"
                                         Placeholder="1px"
                                         @bind-Value="Model.Box.BorderThickness" />
                            </div>
                        </DefaultOverride>
                    </Field>
                    <Field Label="Top"
                           Size="Field.Sizes.Medium"
                           Container="Field.Containers.Div">
                        <DefaultOverride @bind-State="Model.BorderThicknessTopState">
                            <div class="c-min">
                                <TextBox MaxLength="10"
                                         Placeholder="1px"
                                         @bind-Value="Model.Box.BorderThicknessTop" />
                            </div>
                        </DefaultOverride>
                    </Field>
                    <Field Label="Left"
                           Size="Field.Sizes.Medium"
                           Container="Field.Containers.Div">
                        <DefaultOverride @bind-State="Model.BorderThicknessLeftState">
                            <div class="c-min">
                                <TextBox MaxLength="10"
                                         Placeholder="1px"
                                         @bind-Value="Model.Box.BorderThicknessLeft" />
                            </div>
                        </DefaultOverride>
                    </Field>
                    <Field Label="Right"
                           Size="Field.Sizes.Medium"
                           Container="Field.Containers.Div">
                        <DefaultOverride @bind-State="Model.BorderThicknessRightState">
                            <div class="c-min">
                                <TextBox MaxLength="10"
                                         Placeholder="1px"
                                         @bind-Value="Model.Box.BorderThicknessRight" />
                            </div>
                        </DefaultOverride>
                    </Field>
                    <Field Label="Bottom"
                           Size="Field.Sizes.Medium"
                           Container="Field.Containers.Div">
                        <DefaultOverride @bind-State="Model.BorderThicknessBottomState">
                            <div class="c-min">
                                <TextBox MaxLength="10"
                                         Placeholder="1px"
                                         @bind-Value="Model.Box.BorderThicknessBottom" />
                            </div>
                        </DefaultOverride>
                    </Field>
                </Wrapped>
            </Padding>
        </BatchSection>
    </Padding>
</div>
<div class="@(Model.ActiveTab.IsBasically(font) ? String.Empty : "c-hide")">
    <Padding Size="Padding.Sizes.Small"
             Direction="Padding.Directions.Vertical">
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Font"
                   Size="Field.Sizes.Tiny">
                <EnumRadio TEnum="Box.CustomFonts"
                           @bind-SelectedValue="@Model.Box.CustomFontIndex"
                           Orientation="EnumRadio<Box.CustomFonts>.Orientations.Vertical"
                           RadioCssClass="tight-bottom" />
            </Field>
            <Field Label="Size"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.FontSizeState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="1em"
                                 @bind-Value="Model.Box.FontSize" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Weight"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.FontWeightState">
                    <div class="c-min">
                        <select class="input"
                                @bind="Model.Box.FontWeight">
                            <option value="100">100</option>
                            <option value="200">200</option>
                            <option value="300">300</option>
                            <option value="400">400</option>
                            <option value="500">500</option>
                            <option value="600">600</option>
                            <option value="700">700</option>
                            <option value="800">800</option>
                            <option value="900">900</option>
                        </select>
                    </div>
                </DefaultOverride>
            </Field>
        </Wrapped>
    </Padding>
</div>
<div class="@(Model.ActiveTab.IsBasically(frame) ? String.Empty : "c-hide")">
    <Padding Size="Padding.Sizes.Small"
             Direction="Padding.Directions.Vertical">
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Background Image"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <ImageUploader Required="false"
                               ImageFile="Model.Box.BackgroundImageFile" />
            </Field>
            <Field Label="Background Color"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.BackgroundColorState">
                    <div>
                        <ColorPicker @bind-Value="Model.Box.BackgroundColor" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Foreground Color"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.ForegroundColorState">
                    <div>
                        <ColorPicker @bind-Value="Model.Box.ForegroundColor" />
                    </div>
                </DefaultOverride>
            </Field>
        </Wrapped>
    </Padding>
</div>
<div class="@(Model.ActiveTab.IsBasically(margin) ? String.Empty : "c-hide")">
    <Padding Size="Padding.Sizes.Small"
             Direction="Padding.Directions.Vertical">
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Top"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.MarginTopState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="2em"
                                 @bind-Value="Model.Box.MarginTop" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Left"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.MarginLeftState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="2em"
                                 @bind-Value="Model.Box.MarginLeft" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Right"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.MarginRightState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="2em"
                                 @bind-Value="Model.Box.MarginRight" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Bottom"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.MarginBottomState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="2em"
                                 @bind-Value="Model.Box.MarginBottom" />
                    </div>
                </DefaultOverride>
            </Field>
        </Wrapped>
    </Padding>
</div>
<div class="@(Model.ActiveTab.IsBasically(padding) ? String.Empty : "c-hide")">
    <Padding Size="Padding.Sizes.Small"
             Direction="Padding.Directions.Vertical">
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Top"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.PaddingTopState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="2em"
                                 @bind-Value="Model.Box.PaddingTop" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Left"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.PaddingLeftState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="2em"
                                 @bind-Value="Model.Box.PaddingLeft" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Right"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.PaddingRightState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="2em"
                                 @bind-Value="Model.Box.PaddingRight" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Bottom"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.PaddingBottomState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="2em"
                                 @bind-Value="Model.Box.PaddingBottom" />
                    </div>
                </DefaultOverride>
            </Field>
        </Wrapped>
    </Padding>
</div>
<div class="@(Model.ActiveTab.IsBasically(shadow) ? String.Empty : "c-hide")">
    <Padding Size="Padding.Sizes.Small"
             Direction="Padding.Directions.Vertical">
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Blur Radius"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.ShadowBlurRadiusState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder=".5em"
                                 @bind-Value="Model.Box.ShadowBlurRadius" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Color"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.ShadowColorState">
                    <div>
                        <ColorPicker @bind-Value="Model.Box.ShadowColor" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Offset X"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.ShadowOffsetXState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder=".2em"
                                 @bind-Value="Model.Box.ShadowOffsetX" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Offset Y"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.ShadowOffsetYState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder=".2em"
                                 @bind-Value="Model.Box.ShadowOffsetY" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Spread Radius"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.ShadowSpreadRadiusState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder=".5em"
                                 @bind-Value="Model.Box.ShadowSpreadRadius" />
                    </div>
                </DefaultOverride>
            </Field>
        </Wrapped>
    </Padding>
</div>
<div class="@(Model.ActiveTab.IsBasically(text) ? String.Empty : "c-hide")">
    <Padding Size="Padding.Sizes.Small"
             Direction="Padding.Directions.Vertical">
        <Wrapped Alignment="Wrapped.Alignments.Top">
            <Field Label="Heading Line Height"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.HeadingLineHeightState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="1.125"
                                 @bind-Value="Model.Box.HeadingLineHeight" />
                    </div>
                </DefaultOverride>
            </Field>
            <Field Label="Paragraph Line Height"
                   Size="Field.Sizes.Medium"
                   Container="Field.Containers.Div">
                <DefaultOverride @bind-State="Model.ParagraphLineHeightState">
                    <div class="c-min">
                        <TextBox MaxLength="10"
                                 Placeholder="1.5"
                                 @bind-Value="Model.Box.ParagraphLineHeight" />
                    </div>
                </DefaultOverride>
            </Field>
        </Wrapped>
        <BatchSection Title="Text Shadow">
            <Padding Direction="Padding.Directions.Top"
                     Size="Padding.Sizes.Small">
                <Wrapped Alignment="Wrapped.Alignments.Top">
                    <Field Label="Blur Radius"
                           Size="Field.Sizes.Medium"
                           Container="Field.Containers.Div">
                        <DefaultOverride @bind-State="Model.TextShadowBlurRadiusState">
                            <div class="c-min">
                                <TextBox MaxLength="10"
                                         Placeholder="5px"
                                         @bind-Value="Model.Box.TextShadowBlurRadius" />
                            </div>
                        </DefaultOverride>
                    </Field>
                    <Field Label="Color"
                           Size="Field.Sizes.Medium"
                           Container="Field.Containers.Div">
                        <DefaultOverride @bind-State="Model.TextShadowColorState">
                            <div>
                                <ColorPicker @bind-Value="Model.Box.TextShadowColor" />
                            </div>
                        </DefaultOverride>
                    </Field>
                    <Field Label="Offset X"
                           Size="Field.Sizes.Medium"
                           Container="Field.Containers.Div">
                        <DefaultOverride @bind-State="Model.TextShadowOffsetXState">
                            <div class="c-min">
                                <TextBox MaxLength="10"
                                         Placeholder="2px"
                                         @bind-Value="Model.Box.TextShadowOffsetX" />
                            </div>
                        </DefaultOverride>
                    </Field>
                    <Field Label="Offset Y"
                           Size="Field.Sizes.Medium"
                           Container="Field.Containers.Div">
                        <DefaultOverride @bind-State="Model.TextShadowOffsetYState">
                            <div class="c-min">
                                <TextBox MaxLength="10"
                                         Placeholder="2px"
                                         @bind-Value="Model.Box.TextShadowOffsetY" />
                            </div>
                        </DefaultOverride>
                    </Field>
                </Wrapped>
            </Padding>
        </BatchSection>

    </Padding>
</div>
</div>
</div>