<Waiter Model="Model">
    <Filters>
        <Fields></Fields>
        <Buttons>
            <ContextMenu ButtonStyle="ContextMenu.ButtonStyles.Create">
                <MenuItem Type="MenuItem.Types.Refresh"
                          Clicked="() => Model.Refresh()" />
            </ContextMenu>
        </Buttons>
    </Filters>
    <div class="c-sms-message-thread">
        <div id="@Model.MessagesId"
             class="thread-messages">
            @if (Model.Messages.IsEmpty() && Model.PendingReplyBody.HasNothing())
            {
                <NoRecords EntityName="text messages" />
            }
            else
            {
                <div class="c-text-messages"
                     aria-live="polite">
                    @foreach (var message in Model.Messages)
                    {
                        var directionClass = Model.DirectionClass(message);
                        var statusClass = Model.StatusClass(message.Status);

                        <div class="message @directionClass">
                            <div class="bubble @directionClass @statusClass">
                                <div class="text">@message.Body</div>
                                @foreach (var media in Model.MediaFor(message.Id))
                                {
                                    <div class="media">
                                        <Image ImageFile="media.ImageFile"
                                               Sizes="(max-width: 30rem) 75vw, 20rem" />
                                    </div>
                                }
                                <div class="metadata">
                                    <span>@Model.OccurredLabel(message)</span>
                                    @if (Model.ShowStatus(message))
                                    {
                                        <span class="status @statusClass">@message.Status.GetLabel()</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    @if (Model.PendingReplyBody.HasSomething())
                    {
                        <div class="message outbound">
                            <div class="bubble outbound pending">
                                <div class="text">@Model.PendingReplyBody</div>
                                <div class="metadata">
                                    <span class="status pending">Sending</span>
                                    <span class="sending-dots"
                                          aria-hidden="true">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                    <div id="@Model.BottomId"
                         class="thread-bottom"></div>
                </div>
            }
        </div>
        <div class="reply-composer">
            <div class="reply-input">
                <Field Label="Reply"
                       Size="Field.Sizes.Full"
                       Padding="Field.Paddings.None">
                    <MultilineTextBox Placeholder="Message"
                                      @bind-Value="Model.ReplyBody" />
                </Field>
            </div>
            <div class="reply-send">
                <ButtonCore Text="Send"
                            IconClass="c-icon-paper-plane"
                            ButtonStyle="ButtonCore.ButtonStyles.Primary"
                            Disabled="Model.ReplyDisabled"
                            AriaLabel="Send text message"
                            Clicked="Model.SendReply" />
            </div>
        </div>
    </div>
</Waiter>