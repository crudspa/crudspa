<Waiter Model="Model">
    <Filters>
        <Fields>
            <Field Label="Search"
                   Size="Field.Sizes.Medium">
                <SearchTextBox @bind-Value="Model.Search.Text" />
            </Field>
            <Field Label="Occurred"
                   Size="Field.Sizes.Medium">
                <DateFilter Range="Model.Search.OccurredRange" />
            </Field>
            <Sorter Sorts="Model.Sorts"
                    @bind-Selected="Model.Search.Sort.Field"
                    @bind-Ascending="Model.Search.Sort.Ascending" />
        </Fields>
        <Buttons>
            <ButtonAdd EntityName="Sms Message"
                       Clicked="AddNew" />
            <ContextMenu ButtonStyle="ContextMenu.ButtonStyles.Create">
                <MenuItem Type="MenuItem.Types.Reset"
                          Clicked="() => Model.Reset()" />
                <MenuItem Type="MenuItem.Types.Refresh"
                          Clicked="() => Model.Refresh()" />
            </ContextMenu>
        </Buttons>
    </Filters>
</Waiter>
@if (Model.Cards.IsEmpty())
{
    <NoRecords EntityName="sms messages" />
}
else
{
    @foreach (var card in Model.Cards)
    {
        <Card Model="card"
              Title="@card.Entity.Body"
              SupportsDelete="true"
              DeleteRequested="() => Model.Delete(card.Entity.Id)">
            <Values>
                <Field Size="Field.Sizes.Unspecified">
                    <Labeled Width=""
                             Label="Direction"
                             StringValue="@card.Entity.Direction.GetLabel()" />
                    <Labeled Width=""
                             Label="Occurred"
                             DateTimeOffsetValue="@card.Entity.Occurred" />
                    <Labeled Width=""
                             Label="From Number"
                             StringValue="@card.Entity.FromNumber" />
                    <Labeled Width=""
                             Label="To Number"
                             StringValue="@card.Entity.ToNumber" />
                    <Labeled Width=""
                             Label="Body"
                             StringValue="@card.Entity.Body" />
                    <Labeled Width=""
                             Label="Status"
                             StringValue="@card.Entity.Status.GetLabel()" />
                </Field>
            </Values>
            <Buttons>
                <ButtonView Href="@($"{Path}/sms-message-{card.Entity.Id:D}")" />
                <ContextMenu ButtonStyle="ContextMenu.ButtonStyles.View">
                    <MenuItem Type="MenuItem.Types.Delete"
                              Clicked="() => Model.ShowConfirmation(card.Entity.Id)" />
                </ContextMenu>
            </Buttons>
        </Card>
    }

    <Pager Paged="Model.Search.Paged"
           PageNumberChanged="Model.HandlePageNumberChanged" />
}