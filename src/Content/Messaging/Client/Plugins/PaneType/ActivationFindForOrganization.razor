<Waiter Model="Model">
    <Filters>
        <Fields>
        </Fields>
        <Buttons>
            <ContextMenu ButtonStyle="ContextMenu.ButtonStyles.Create">
                <MenuItem Type="MenuItem.Types.Reset"
                          Clicked="() => Model.Reset()" />
                <MenuItem Type="MenuItem.Types.Refresh"
                          Clicked="() => Model.Refresh()" />
            </ContextMenu>
        </Buttons>
    </Filters>
</Waiter>
@if (Model.Cards.IsEmpty())
{
    <NoRecords EntityName="activations" />
}
else
{
    @foreach (var card in Model.Cards)
    {
        <Card Model="card"
              Title="@card.Entity.CampaignName"
              SupportsDelete="false">
            <Values>
                <Field Size="Field.Sizes.Unspecified">
                    <Labeled Width="8em"
                             Label="Start"
                             DateOnlyValue="@card.Entity.Start" />
                    <Labeled Width="8em"
                             Label="Activated"
                             DateTimeOffsetValue="@card.Entity.Activated" />
                </Field>
            </Values>
            <Buttons>
                <ButtonView Href="@($"{Path}/activation-{card.Entity.Id:D}")" />
            </Buttons>
        </Card>
    }

    <Pager Paged="Model.Search.Paged"
           PageNumberChanged="Model.HandlePageNumberChanged" />
}